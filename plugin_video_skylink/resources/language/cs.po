msgid "Service"
msgstr "Služba"

msgid "Login name"
msgstr "Přihlašovací jméno"

msgid "Login password"
msgstr "Přihlašovací heslo"

msgid "Maximum bandwidth of the offered stream"
msgstr "Maximální šířka pásma nabízeného streamu"

msgid "Privacy mode for the license request"
msgstr "Privacy mode při žádosti o licenci"

msgid "Device (set automatically)"
msgstr "Zařízení (nastaví se automaticky)"

msgid "Session (set automatically after sign-in)"
msgstr "Session (nastaví se automaticky po přihlášení)"

msgid "All channels"
msgstr "Všechny kanály"



msgid "Account"
msgstr "Účet"

msgid "Signed in as: %s"
msgstr "Přihlášen jako: %s"

msgid "Service: %s"
msgstr "Služba: %s"

msgid "Device: %s"
msgstr "Zařízení: %s"

msgid "Sign out this device"
msgstr "Odhlásit toto zařízení"

msgid "Do you really want to sign out? The saved sign-in will be deleted, the username and password stay in the settings."
msgstr "Opravdu se chceš odhlásit? Uložené přihlášení se smaže, jméno a heslo zůstanou v nastavení."

msgid "Signed out."
msgstr "Odhlášeno."

msgid "Wrong username or password - check the addon settings."
msgstr "Nesprávné jméno nebo heslo - zkontroluj nastavení doplňku."


msgid "The account is blocked or inactive."
msgstr "Účet je zablokovaný nebo neaktivní."

msgid "Sign-in failed: %s"
msgstr "Přihlášení selhalo: %s"





msgid "Failed to load the TV guide: %s"
msgstr "Nepodařilo se načíst TV program: %s"





msgid "Missing item identifier."
msgstr "Chybí identifikátor položky."

msgid "This channel is not part of your subscription."
msgstr "Tento kanál není součástí tvého předplatného."

msgid "The broadcast is not available from this network (geoblocking)."
msgstr "Přenos není z této sítě dostupný (geoblokování)."

msgid "Playback failed: %s"
msgstr "Přehrávání selhalo: %s"

msgid "No stream URL received from server."
msgstr "Ze serveru nepřišla adresa streamu."

msgid "No license URL received. The stream cannot be played."
msgstr "Nepřišla licenční adresa. Stream nelze přehrát."

msgid "Failed to load the DASH stream."
msgstr "Nepodařilo se načíst DASH stream."

msgid "Movies and series"
msgstr "Filmy a seriály"

msgid "Sport"
msgstr "Sport"

msgid "Documentary"
msgstr "Dokumenty"

msgid "News"
msgstr "Zpravodajství"

msgid "Kids"
msgstr "Pro děti"

msgid "Entertainment"
msgstr "Zábava"

msgid "Cooking"
msgstr "Vaření"

msgid "Lifestyle"
msgstr "Životní styl"

msgid "Music"
msgstr "Hudba"

msgid "Culture"
msgstr "Kultura"

msgid "Adult"
msgstr "Pro dospělé"

msgid "Advanced"
msgstr "Rozšířené"

msgid "Userbouquet"
msgstr "Userbouquet"

msgid "Archive"
msgstr "Archiv"

msgid "Enable adult channels"
msgstr "Povolit kanály pro dospělé"

msgid "Automatically export channel list as userbouquet"
msgstr "Automaticky exportovat seznam kanálů jako userbouquet"

msgid "Generate XML EPG for epgimport plugin (if installed)"
msgstr "Generovat XML EPG pro plugin epgimport (pokud je nainstalován)"

msgid "Directory for XML EPG data (need at least 20MB of free space)"
msgstr "Složka pro data XML EPG (je třeba alespoň 20 MB volného místa)"

msgid "For how many days to generate XML EPG"
msgstr "Na kolik dní generovat XML EPG"

msgid "Automatically download picons when exporting userbouquet"
msgstr "Při exportu userbouquetu automaticky stáhnout picony"

msgid "Player used for userbouquet"
msgstr "Přehrávač použitý pro userbouquet"

msgid "Convert streams to TS format using ffmpeg"
msgstr "Konvertovat streamy do formátu TS přes ffmpeg"

msgid "Enable special section in main menu"
msgstr "Zapnout speciální sekci v hlavním menu"

msgid "Allow downloading of live broadcasting"
msgstr "Povolit stahování živého vysílání"

msgid "Registered devices"
msgstr "Zaregistrovaná zařízení"

msgid "Here you can see the devices registered to your account and free up a slot."
msgstr "Zde vidíš zařízení zaregistrovaná na účtu a můžeš uvolnit místo."

msgid "Shows which account the addon is signed in with."
msgstr "Ukáže, pod kterým účtem je doplněk přihlášen."

msgid "This is the device used by the addon."
msgstr "Toto zařízení používá doplněk."

msgid "In the menu you can remove this device and free up a slot."
msgstr "V menu můžeš toto zařízení odebrat a uvolnit místo."

msgid "Remove device!"
msgstr "Odebrat zařízení!"

msgid "Do you really want to remove the device %s?"
msgstr "Opravdu chceš odebrat zařízení %s?"

msgid "Device %s was removed."
msgstr "Zařízení %s bylo odebráno."

msgid "Failed to remove the device: %s"
msgstr "Zařízení se nepodařilo odebrat: %s"

msgid "Failed to load the device list: %s"
msgstr "Nepodařilo se načíst seznam zařízení: %s"

msgid "Run EPG export to enigma or XML files"
msgstr "Spustit export EPG do enigmy nebo XML souborů"

msgid "EPG export started"
msgstr "Export EPG byl spuštěn"

msgid "The limit of registered devices has been reached. Remove one device in the Special section, in the Skylink app or on the website."
msgstr "Dosáhl jsi limitu registrovaných zařízení. Odeber jedno zařízení ve speciální sekci, v aplikaci Skylink nebo na webu."

msgid "Radio"
msgstr "Rádia"

msgid "Check playback"
msgstr "Zkontrolovat přehrávání"

msgid "With this button you can check if playback works OK or it gives some error from the server."
msgstr "Tímto si ověříš, zda přehrávání funguje, nebo server hlásí chybu."

msgid "No error occured during playback check. Playback should work."
msgstr "Při kontrole přehrávání nenastala chyba, přehrávání by mělo fungovat."

msgid "Can't check playback. There are no channels available."
msgstr "Přehrávání nelze zkontrolovat, nejsou dostupné žádné kanály."

msgid "The server did not return a stream or a license address."
msgstr "Server nevrátil adresu streamu nebo licence."

msgid "Load programme descriptions (slower, only for shorter lists)"
msgstr "Načítat popisy pořadů (pomalejší, jen u kratších seznamů)"

msgid "Maximum resolution of the offered stream"
msgstr "Maximální rozlišení nabízeného streamu"

msgid "Your sign-in has expired."
msgstr "Přihlášení vypršelo."

msgid "The server returned an empty channel list."
msgstr "Server vrátil prázdný seznam kanálů."

msgid "Special section"
msgstr "Speciální sekce"

msgid "Unlimited"
msgstr "Bez omezení"

msgid "Default"
msgstr "Předvolený"

msgid "gstplayer"
msgstr ""

msgid "exteplayer3"
msgstr ""

msgid "DMM"
msgstr ""

msgid "DVB (OE>=2.5)"
msgstr ""

msgid "8 Mbit/s"
msgstr ""

msgid "6 Mbit/s"
msgstr ""

msgid "4 Mbit/s"
msgstr ""

msgid "3 Mbit/s"
msgstr ""

msgid "2 Mbit/s"
msgstr ""

msgid "Allow DRM decrypt using exteplayer3"
msgstr "Povolit dešifrování DRM pomocí exteplayer3"

msgid "Enable 1080p streams (experimental)"
msgstr "Povolit streamy v rozlišení 1080p (experimentální)"

msgid "Playback of stream with 1080p quality failed. Switching back to 720p quality."
msgstr "Přehrávání streamu v rozlišení 1080p selhalo. Přepínám zpět na 720p."

msgid "You have enabled 1080p streams in addon settings. This option works only in distributions based on python 3.8+ like OpenATV 7.x, OpenPLi > 9.x etc. Update software in you receiver to get better quality streams."
msgstr "V nastavení doplňku máš zapnuté streamy v rozlišení 1080p. Tato možnost funguje jen na distribucích postavených na Pythonu 3.8 a novějším, například OpenATV 7.x nebo OpenPLi > 9.x. Pokud chceš kvalitnější streamy, aktualizuj software v přijímači."
