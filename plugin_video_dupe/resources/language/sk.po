#: plugin_video_dupe/dupe.py:77
msgid "Unexpected return code from server"
msgstr "Neočakávaný návratový kód zo servera"

#: plugin_video_dupe/dupe.py:123
#, python-brace-format
msgid "Login failed with response code {code}"
msgstr "Prihlásenie sa nezdařilo s kódom odpovede {code}"

#: plugin_video_dupe/dupe.py:126
msgid "Login failed - probably wrong username or password"
msgstr "Prihlásenie sa nepodarilo – pravdepodobne nesprávne používateľské meno alebo heslo"

#: plugin_video_dupe/stream_provider.py:228
msgid "Your internet provider is blocking access to site containing this video."
msgstr "Váš poskytovateľ internetu blokuje prístup na stránku obsahujúcu toto video."

#: plugin_video_dupe/provider.py:29
msgid "Login failed. Check your login credentials in addon settings."
msgstr "Prihlásenie sa nepodarilo. Skontrolujte svoje prihlasovacie údaje v nastaveniach doplnku."

#: plugin_video_dupe/provider.py:37
msgid "Movies"
msgstr "Filmy"

#: plugin_video_dupe/provider.py:38
msgid "Series"
msgstr "Seriály"

#: plugin_video_dupe/provider.py:51 plugin_video_dupe/provider.py:60
msgid "All"
msgstr "Všetko"

#: plugin_video_dupe/provider.py:55 plugin_video_dupe/provider.py:64
msgid "By genre"
msgstr "Podľa žánru"

#: plugin_video_dupe/provider.py:174
msgid "You have reached the limit for not users that do not support development of ArchivCZSK. Playback of another item is not available for you."
msgstr "Dosiahli ste limit pre používateľov, ktorí nepodporujú vývoj ArchivCZSK. Prehrávanie ďalšej položky nie je pre vás k dispozícii."

#: plugin_video_dupe/provider.py:179
msgid "No supported stream provider found"
msgstr "Nebol nájdený žiadny podporovaný poskytovateľ streamov"

#: plugin_video_dupe/provider.py:192
msgid "Please select a stream"
msgstr "Vyberte si stream"

#: plugin_video_dupe/provider.py:215
msgid "This video stream is not available. Try to select different one."
msgstr "Tento video stream nie je k dispozícii. Skúste vybrať iný."

#: plugin_video_dupe/provider.py:235
msgid "Subtitles"
msgstr "Titulky"

#: plugin_video_dupe/provider.py:237
msgid "Please select subtitles"
msgstr "Prosím vyberte titulky"

msgid "Login name"
msgstr "Prihlasovacie meno"

msgid "Login password"
msgstr "Prihlasovacie heslo"

msgid "Max watched items"
msgstr "Maximálny počet videných položiek"

msgid "Enable subtitles support"
msgstr "Povoliť podporu pre titulky"

#~ msgid "You have reached the limit and playback of another item is not available for you."
#~ msgstr "Dosiahli ste limit a prehrávanie ďalšej položky nie je pre vás k dispozícii."

#~ msgid "Login failed. Check your credentials. Without valid credentials you will be unable to watch any content."
#~ msgstr "Prihlásenie sa nepodarilo. Skontrolujte svoje prihlasovacie údaje. Bez platných prihlasovacích údajov nebudete môcť sledovať žiadny obsah."

#~ msgid "In order to play content you need to enter login credentials in addon's setting."
#~ msgstr "Aby ste mohli prehrávať obsah, musíte zadať prihlasovacie údaje v nastaveniach doplnku."

#~ msgid "Login to premium account failed. Continuing with free account."
#~ msgstr "Prihlásenie k premium kontu zlyhalo. Pokračujem s free kontom."

