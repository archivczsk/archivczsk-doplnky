msgstr "Podľa žánru"

#: plugin_video_sweettv/provider.py:175
msgid "By collection"
msgstr "Podľa kolekcie"

#: plugin_video_sweettv/provider.py:210
msgid "Special section"
msgstr "Špeciálna sekcia"

#: plugin_video_sweettv/provider.py:221
msgid "Here you can show and optionaly remove/unregister unneeded devices, so you can login on another one."
msgstr "Tu si môžete zobraziť a prípadne vymazať/odregistrovať zbytočné zariadenia, aby ste sa mohli znova inde prihlásiť."

#: plugin_video_sweettv/provider.py:222
msgid "Registered devices"
msgstr "Zaregistrované zariadenia"

#: plugin_video_sweettv/provider.py:223
msgid "Run EPG export to enigma or XML files"
msgstr "Spustiť EPG export do enigmy alebo do XML súborov"

#: plugin_video_sweettv/provider.py:224
msgid "Forces logout from this devices and does new login. Use if you have problem with playback. After running this option it's necessary to go out of this addon to force new automatic login."
msgstr "Vynúti odhlásenie z tohto zariadenia a vykoná nové prihlásenie. Použite to v prípade problémov s prehrávaním. Po spustení tejto voľby je nutné doplnok opustiť a vrátiť sa späť pre opätovné prihlásenie."

#: plugin_video_sweettv/provider.py:225
msgid "Logout from this device"
msgstr "Odhlásiť sa z tohto zariadenia"

#: plugin_video_sweettv/provider.py:231
msgid "EPG export started"
msgstr "EPG export bol spustený"

#: plugin_video_sweettv/provider.py:238 plugin_video_sweettv/provider.py:239
msgid "You have been logged out!"
msgstr "Boli ste odhlásený!"

#: plugin_video_sweettv/provider.py:247
msgid "In menu you can remove device using Remove device!"
msgstr "V menu môžete zariadenie vymazať pomocou Zmazať zariadenie!"

#: plugin_video_sweettv/provider.py:250
msgid "Remove device!"
msgstr "Zmazať zariadenie!"

#: plugin_video_sweettv/provider.py:257
#, python-brace-format
msgid "Device {device} was removed!"
msgstr "Zariadenie {device} bolo vymazané!"

#: plugin_video_sweettv/provider.py:297
msgid "You need valid subscription and pair this device in order to use the addon. Start pairing process now?"
msgstr "Na používanie doplnku je potrebné platné predplatné a spárovanie tohto zariadenia. Spustiť proces párovania teraz?"

#: plugin_video_sweettv/provider.py:303
#, python-brace-format
msgid ""
"Go to sweet.tv website using computer or mobile phone and login to your account.\n"
"Then navigate to your profile, section \"My devices\". You will see an input box to pair new device.\n"
"Enter code \"{code}\" and press \"Activate\". When you finish confirm this dialog by pressing OK on remote control."
msgstr ""
"Prejdite na webovú stránku sweet.tv pomocou počítača alebo mobilného telefónu a prihláste sa do svojho konta.\n"
"Potom prejdite do svojho profilu, časť \"Moje zariadenia\". Zobrazí sa vstupné pole na spárovanie nového zariadenia.\n"
"Zadajte kód \"{code}\" a stlačte tlačidlo \"Aktivovať\". Po dokončení potvrďte toto dialógové okno stlačením tlačidla OK na diaľkovom ovládači."

